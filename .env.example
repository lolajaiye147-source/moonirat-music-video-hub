# Moonirat public application configuration
NODE_ENV=development
PORT=3000
BASE_PATH=/
PUBLIC_APP_URL=http://localhost:3000

# Supabase public configuration. These values are safe for the browser and
# remain protected by Row Level Security, not by secrecy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret. Never prefix this value with VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-secret

# Separate API service configuration
CORS_ORIGINS=http://localhost:3000,https://moonirat.space,https://www.moonirat.space
API_BODY_LIMIT=1mb

# Optional shared database package. Moonirat product data currently uses
# Supabase directly and does not require this value in the browser.
DATABASE_URL=postgresql://user:password@localhost:5432/moonirat